# Copy to .env on your device. Never commit .env, never paste these into a chat.
# JARVIS_PORT=8720
# JARVIS_VAULT=/path/to/your/notes   (defaults to ./vault)
# Never set ANTHROPIC_API_KEY here: it switches you from your subscription to per-token billing.

# --- WhatsApp (optional; see README) ---
# JARVIS_WA_OWNER=447700900123            your own WhatsApp number, country code, digits only
# JARVIS_WA_PHONE_NUMBER_ID=              from Meta > WhatsApp > API Setup
# JARVIS_WA_TOKEN=                        permanent System User token (not the 24h test token)
# JARVIS_WA_APP_SECRET=                   Meta app > Settings > Basic > App secret
# JARVIS_WA_VERIFY_TOKEN=                 any long random string you make up
# JARVIS_WA_PORT=8721

# --- JARVIS voice (optional; free key at fish.audio > API keys) ---
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_VOICE_ID=                    leave empty to auto-pick the most popular "Jarvis" voice
# FISH_AUDIO_MODEL=s2.1-pro-free

# --- Background watch ---
# JARVIS_WATCH_MINUTES=60                 0 turns the hourly account check off
